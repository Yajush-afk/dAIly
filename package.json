{
  "name": "daily-mentor",
  "version": "0.1.0",
  "description": "A local desktop mentor for variable college days",
  "main": "out/main/index.js",
  "author": "Yajush-afk",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview:ui": "vite --config vite.preview.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:desktop": "npm run build && node scripts/smoke.mjs",
    "evaluate:gemma": "tsx scripts/evaluate-gemma.mts",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "package": "npm run build && electron-builder --publish never",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "data:path": "node scripts/data-path.mjs",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json docs README.md .github/workflows/windows.yml",
    "format:check": "prettier --check src tests scripts *.ts *.mjs *.json docs README.md .github/workflows/windows.yml",
    "benchmark:history": "tsx scripts/benchmark-history.mts"
  },
  "build": {
    "appId": "dev.daily.mentor",
    "productName": "dAIly",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "asar": true,
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "dAIly-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": "dir"
    }
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "luxon": "3.7.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": "5.1.0"
    }
  }
}
